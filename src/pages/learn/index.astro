---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = (await getCollection('guides')).filter((g) => !g.data.draft);
guides.sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());
---
<BaseLayout title="Learn — Sustainability Guides | Eco Happy" description="Honest guides on plantable stationery, sustainable gifting and spotting greenwashing, written from Eco Happy's own Pune workshop and production floor.">
  <section class="container hero">
    <h1>Learn</h1>
    <p>Straight answers on plantable stationery, sustainable gifting and how to tell a real green claim from marketing — written by the people who make the products.</p>
  </section>
  <section class="container grid">
    {guides.map((g) => (
      <a class="guide-card card" href={`/learn/${g.data.slug}/`}>
        <div class="media">
          {g.data.cover
            ? <img src={g.data.cover} alt={g.data.coverAlt || g.data.title} loading="lazy" width="400" height="240" />
            : <span class="media-placeholder" aria-hidden="true"></span>}
        </div>
        <div class="body">
          <h2>{g.data.title}</h2>
          <p>{g.data.description}</p>
          <p class="meta">{g.data.timeToRead}</p>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .hero { padding-block: 2rem 1rem; max-width: 68ch; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem; padding-block: 1.5rem 3rem; }
  .guide-card { display: block; text-decoration: none; color: var(--ink); }
  /* The media box is always rendered, so cards without a cover keep the row's baseline. overflow:hidden here (not on .guide-card) so the hover zoom clips to the image, not the whole card. */
  .guide-card .media { aspect-ratio: 5/3; background: var(--cream); overflow: hidden; }
  .guide-card img, .guide-card .media-placeholder { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .guide-card:hover img { transform: scale(1.1); }
  @media (prefers-reduced-motion: reduce) { .guide-card:hover img { transform: none; } }
  .guide-card .body { padding: 1rem; }
  .guide-card h2 { font-size: 1.05rem; margin-bottom: 0.4em; }
  .guide-card p { font-size: 0.9rem; color: var(--ink); margin-bottom: 0.4em; }
  .guide-card .meta { color: var(--red-deep); font-size: 0.8rem; }
</style>
