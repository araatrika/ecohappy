---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import site from '../../data/site.json';

// The intro line comes from the editable page entry (src/content/pages/contact.md).
// Contact details come from site.json, the same source as the footer and the schema, so they can't drift.
const entry = await getEntry('pages', 'contact');
const { Content } = await render(entry);

const whatsappHref = `${site.whatsapp.direct}?text=${encodeURIComponent('Hi Eco Happy, I have a question.')}`;
const quoteHref = `${site.whatsapp.direct}?text=${encodeURIComponent("Hi Eco Happy, I'd like a quote for a bulk or custom order.")}`;
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <section class="container contact-hero">
    <div class="hero-text">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <div class="lede"><Content /></div>
      <div class="hero-actions">
        <a class="btn btn-primary" href={whatsappHref} target="_blank" rel="noopener">Chat on WhatsApp</a>
        <a class="btn btn-outline" href="#enquiry">Send an enquiry</a>
      </div>
    </div>
    <figure class="hero-photo">
      <img src="/assets/brand/contact-page-hero.jpg" alt="A hand writing in a notebook with a fenugreek seed pen" />
    </figure>
  </section>

  <section class="container contact-ways" aria-labelledby="ways-heading">
    <h2 id="ways-heading">Ways to reach us</h2>
    <div class="ways-grid">
      <article class="way-card">
        <svg class="way-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
        <h3>WhatsApp</h3>
        <p>Quick questions, order follow-ups and bulk quotes.</p>
        <a class="btn btn-primary way-btn" href={whatsappHref} target="_blank" rel="noopener">Chat on WhatsApp</a>
        <p class="way-meta"><a href={`tel:${site.telephoneE164}`}>{site.telephone}</a></p>
      </article>

      <article class="way-card">
        <svg class="way-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
        <h3>Email</h3>
        <p>For longer messages and attachments.</p>
        <p class="way-meta"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </article>

      <article class="way-card">
        <svg class="way-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
        <h3>Our Pune workshop</h3>
        <address>{site.address.streetAddress}, {site.address.addressLocality}, {site.address.addressRegion} {site.address.postalCode}</address>
        <p class="way-meta"><a href={site.mapsSearchUrl} target="_blank" rel="noopener">Get directions</a></p>
      </article>

      <article class="way-card">
        <svg class="way-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
        <h3>Leave a review</h3>
        <p>Ordered from us? A short Google review helps other buyers find us.</p>
        <p class="way-meta"><a href={site.googleBusinessProfile.reviewUrl} target="_blank" rel="noopener">Review us on Google</a></p>
      </article>
    </div>
  </section>

  <section class="enquiry-band section-cream" id="enquiry">
    <div class="container enquiry-grid">
      <div class="enquiry-aside">
        <h2>Custom orders and bulk gifting</h2>
        <p>Tell us what you have in mind and we'll come back with options and pricing. These details help:</p>
        <ul class="checklist">
          <li>What you want, or "not sure yet"</li>
          <li>Quantity, and whether you want a logo or custom text</li>
          <li>Delivery city and pincode</li>
          <li>Your date or deadline</li>
        </ul>
        <p class="aside-note">Already ordered? Include the order reference from your payment confirmation so we can find your order.</p>
        <a class="btn btn-outline" href={quoteHref} target="_blank" rel="noopener">Ask for a quote on WhatsApp</a>
      </div>
      <div class="enquiry-main">
        <EnquiryForm
          formName="enquiry-contact"
          heading="Send us an enquiry"
          intro="We'll reply to the email or phone number you give us."
          contextLabel="Contact page"
        />
      </div>
    </div>
  </section>

  <section class="container made-band">
    <div class="made-text">
      <h2>Made in Pune, by a women-led team</h2>
      <p>Plantable stationery, seed paper and upcycled gifts, with most products made in our Pune workshop. Some items are bought in, and their product pages say so.</p>
      <p class="made-links"><a href="/shop/">Shop all products</a> <span aria-hidden="true">·</span> <a href="/customisation/">Customisation</a> <span aria-hidden="true">·</span> <a href="/gifting/corporate/">Corporate gifting</a></p>
    </div>
    <div class="photo-pair">
      <img src="/assets/pages/contact/3-edited-jpg.jpg" alt="Eco Happy seed pencil packs, made by women in India" loading="lazy" />
      <img src="/assets/pages/contact/4-edited-jpg.jpg" alt="Eco Happy plantable stationery" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; padding-block: 2.5rem; }
  .eyebrow {
    font-family: var(--font-label); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--red-deep); margin: 0 0 0.4em;
  }
  .lede { font-size: 1.1rem; color: var(--gray-500); max-width: 52ch; }
  .lede :global(p) { margin: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .hero-photo { margin: 0; }
  .hero-photo img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 14px; box-shadow: var(--shadow-card); }

  .contact-ways { padding-block: 2.5rem; }
  .contact-ways h2 { margin-bottom: 1.25rem; }
  .ways-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .way-card {
    display: flex; flex-direction: column; gap: 0.5rem; background: var(--white);
    border: 1px solid var(--gray-200); border-radius: 14px; padding: 1.4rem; box-shadow: var(--shadow-card);
  }
  .way-icon { width: 1.6rem; height: 1.6rem; fill: none; stroke: var(--forest); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 0.2rem; }
  .way-card h3 { font-size: 1.1rem; margin: 0; }
  .way-card p { font-size: 0.92rem; color: var(--gray-500); margin: 0; }
  .way-card address { font-style: normal; font-size: 0.92rem; color: var(--ink); line-height: 1.5; }
  .way-meta { margin-top: auto; padding-top: 0.4rem; font-weight: 600; overflow-wrap: anywhere; }
  .way-meta a { color: var(--forest); }
  .way-btn { width: 100%; margin-top: auto; }

  .enquiry-band { scroll-margin-top: 90px; }
  .enquiry-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 2.5rem; align-items: start; padding-block: 3rem; }
  .enquiry-aside h2 { margin-bottom: 0.6em; }
  .enquiry-aside > p { color: var(--ink); }
  .checklist { padding-left: 1.2rem; margin: 0 0 1.25rem; }
  .checklist li { margin-bottom: 0.35rem; }
  .aside-note { font-size: 0.92rem; color: var(--gray-500); margin-bottom: 1.25rem; }
  .enquiry-main :global(.enquiry-form) {
    max-width: none; margin: 0; padding: 1.5rem; background: var(--white);
    border-radius: 14px; box-shadow: var(--shadow-card);
  }

  .made-band { display: grid; grid-template-columns: 1fr 1fr; gap: 2.25rem; align-items: center; padding-block: 3rem 3.5rem; }
  .made-band h2 { margin-bottom: 0.5em; }
  .made-links { font-size: 0.95rem; }
  .photo-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .photo-pair img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 14px; }

  @media (max-width: 1000px) {
    .ways-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .contact-hero, .enquiry-grid, .made-band { grid-template-columns: 1fr; gap: 1.75rem; }
    .contact-hero { padding-block: 1.5rem 2rem; }
    .hero-photo img { aspect-ratio: 4 / 3; }
    .photo-pair img { aspect-ratio: 4 / 3; }
    .enquiry-grid { padding-block: 2.25rem 2.5rem; }
  }
  @media (max-width: 560px) {
    .ways-grid { grid-template-columns: 1fr; }
    .hero-actions .btn { width: 100%; }
    .enquiry-main :global(.enquiry-form) { padding: 1.1rem; }
  }
</style>
