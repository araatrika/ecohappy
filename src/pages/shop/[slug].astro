---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;
const onSale = typeof p.salePrice === 'number' && p.salePrice < p.price;
const cat = site.categories.find((c) => c.slug === p.category);

const allProducts = await getCollection('products');
const related = p.related
  .map((slug) => allProducts.find((r) => r.data.slug === slug))
  .filter(Boolean)
  .slice(0, 3);

// Spec keys are stored camelCase in frontmatter; the table needs human labels.
const SPEC_LABELS = {
  material: 'Material',
  size: 'Size',
  pages: 'Pages',
  seeds: 'Seeds',
  contents: 'Contents',
  packaging: 'Packaging',
  madeIn: 'Made in',
  madeBy: 'Made by',
};
// Unknown keys (a new one added through /admin) de-camelCase rather than print raw.
const specLabel = (k) =>
  SPEC_LABELS[k] || k.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase());
const specsEntries = Object.entries(p.specs || {});

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.sku || undefined,
  brand: { '@type': 'Brand', name: p.brand },
  description: p.seoDescription || p.answer || undefined,
  image: p.images.map((img) => new URL(img.src, site.hosts.canonical).toString()),
  offers: {
    '@type': 'Offer',
    price: onSale ? p.salePrice : p.price,
    priceCurrency: p.currency,
    availability: `https://schema.org/${p.availability}`,
    url: new URL(`/shop/${p.slug}/`, site.hosts.canonical).toString(),
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.hosts.canonical + '/' },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: new URL('/shop/', site.hosts.canonical).toString() },
    { '@type': 'ListItem', position: 3, name: cat ? cat.name : p.categoryName, item: new URL(`/shop/${p.category}/`, site.hosts.canonical).toString() },
    { '@type': 'ListItem', position: 4, name: p.name, item: new URL(`/shop/${p.slug}/`, site.hosts.canonical).toString() },
  ],
};
const faqSchema = p.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: p.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const whatsappMsg = encodeURIComponent(`Hi, I'd like to ask about bulk pricing for "${p.name}" (${p.sku || p.slug}).`);
---
<BaseLayout
  title={p.seoTitle || `${p.name} | Eco Happy`}
  description={p.seoDescription || p.answer || site.tagline}
  image={p.images?.[0]?.src}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <section class="container product">
    <p class="crumb">
      <a href="/shop/">Shop</a>{cat && <> / <a href={cat.url}>{cat.name}</a></>} / {p.name}
    </p>

    <div class="layout">
      <div class="gallery">
        {p.images.length > 0 ? (
          <>
            <img class="hero-img" src={p.images[0].src} alt={p.images[0].alt || `${p.name} — Eco Happy`} width={p.images[0].width} height={p.images[0].height} />
            {p.images.length > 1 && (
              <div class="thumbs">
                {p.images.slice(1).map((img) => (
                  <img src={img.src} alt={img.alt || `${p.name} — detail`} loading="lazy" width="150" height="150" />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="hero-img placeholder" aria-hidden="true"></div>
        )}
      </div>

      <div class="info">
        {p.ribbon && <span class="badge">{p.ribbon}</span>}
        <h1>{p.name}</h1>
        {p.answer && <p class="answer">{p.answer}</p>}
        <p class="price">
          {onSale ? (
            <>
              <span class="was">Was ₹{p.price}</span>
              <span class="now">Now ₹{p.salePrice}</span>
            </>
          ) : (
            <span class="now">₹{p.price}</span>
          )}
        </p>

        <div class="cta-row">
          {p.bulk ? (
            <a class="btn btn-primary" href={`${site.whatsapp.direct}?text=${whatsappMsg}`} target="_blank" rel="noopener">
              Reach out on WhatsApp
            </a>
          ) : (
            <>
              <button class="btn btn-primary" type="button" id="buy-now" data-slug={p.slug} data-name={p.name}>
                Buy now
              </button>
              <a class="btn btn-outline" href={`${site.whatsapp.direct}?text=${whatsappMsg}`} target="_blank" rel="noopener">
                Ask about bulk / corporate pricing
              </a>
            </>
          )}
        </div>
        {p.bulk && <p class="made-to-order-note">Made to order — usually ready in about {p.leadTimeDays} days after we confirm your order on WhatsApp.</p>}
        <p id="buy-status" class="buy-status" role="status" aria-live="polite"></p>

        {specsEntries.length > 0 && (
          <table class="specs">
            <caption class="visually-hidden">Product specifications</caption>
            <tbody>
              {specsEntries.map(([k, v]) => (
                <tr><th scope="row">{specLabel(k)}</th><td>{String(v)}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>

    <div class="description">
      <Content />
    </div>

    {p.faq.length > 0 && (
      <section class="faqs" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        {p.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>You may also like</h2>
        <div class="grid">
          {related.map((r) => <ProductCard product={r} />)}
        </div>
      </section>
    )}
  </section>
</BaseLayout>

<script>
  const btn = document.getElementById('buy-now');
  const status = document.getElementById('buy-status');

  function loadRazorpayScript() {
    return new Promise((resolve, reject) => {
      if (window.Razorpay) return resolve();
      const s = document.createElement('script');
      s.src = 'https://checkout.razorpay.com/v1/checkout.js';
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('Could not load the payment library. Check your connection and try again.'));
      document.body.appendChild(s);
    });
  }

  btn?.addEventListener('click', async () => {
    const slug = btn.dataset.slug;
    const name = btn.dataset.name;
    btn.disabled = true;
    status.textContent = 'Preparing checkout…';
    try {
      const [orderRes] = await Promise.all([
        fetch('/.netlify/functions/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, quantity: 1 }),
        }),
        loadRazorpayScript(),
      ]);
      if (!orderRes.ok) {
        const err = await orderRes.json().catch(() => ({}));
        throw new Error(err.error || 'Could not start checkout.');
      }
      const order = await orderRes.json();

      const rzp = new window.Razorpay({
        key: order.keyId,
        order_id: order.orderId,
        amount: order.amount,
        currency: order.currency,
        name: 'Eco Happy',
        description: order.productName,
        image: '/assets/brand/logo-eco-happy.png',
        theme: { color: '#005018' },
        handler: async (response) => {
          status.textContent = 'Verifying payment…';
          try {
            const verifyRes = await fetch('/.netlify/functions/verify-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(response),
            });
            const result = await verifyRes.json();
            if (result.verified) {
              status.textContent = `Payment confirmed — thank you! We'll be in touch about delivery for your ${name}.`;
            } else {
              status.textContent = 'We could not verify that payment. Please contact us on WhatsApp with your payment ID before retrying.';
            }
          } catch {
            status.textContent = 'Payment may have gone through, but we could not confirm it here — please contact us on WhatsApp with your payment ID.';
          } finally {
            btn.disabled = false;
          }
        },
        modal: {
          ondismiss: () => {
            status.textContent = '';
            btn.disabled = false;
          },
        },
      });
      rzp.on('payment.failed', () => {
        status.textContent = 'Payment failed — no charge was made. You can try again.';
        btn.disabled = false;
      });
      rzp.open();
      status.textContent = '';
    } catch (err) {
      status.textContent = err.message || 'Something went wrong starting checkout.';
      btn.disabled = false;
    }
  });
</script>


<style>
  .product { padding-block: 1.5rem 3rem; }
  .crumb { font-size: 0.85rem; }
  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; margin-block: 1rem 2rem; }
  .hero-img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--radius); background: var(--cream); }
  .hero-img.placeholder { display: block; }
  .thumbs { display: flex; gap: 0.6rem; margin-top: 0.75rem; }
  .thumbs img { width: 70px; height: 70px; object-fit: cover; border-radius: 6px; }
  .answer { font-size: 1.05rem; color: var(--red-deep); }
  .price { font-size: 1.4rem; font-weight: 600; margin: 1rem 0; }
  .was { text-decoration: line-through; color: #6b6b5c; font-weight: 400; margin-right: 0.6em; font-size: 0.85em; }
  .now { color: var(--red-deep); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; }
  .buy-status { min-height: 1.2em; font-size: 0.9rem; color: var(--red-deep); font-weight: 600; }
  .made-to-order-note { font-size: 0.85rem; color: var(--gray-500); margin: -0.75rem 0 1rem; }
  .specs { border-collapse: collapse; width: 100%; margin-top: 1rem; }
  .specs th, .specs td { text-align: left; padding: 0.4em 0.6em 0.4em 0; border-bottom: 1px solid var(--cream); font-size: 0.9rem; }
  .specs th { color: var(--ink); font-weight: 700; width: 40%; }
  .description { max-width: 68ch; margin-bottom: 2.5rem; }
  .faqs { max-width: 68ch; margin-bottom: 2.5rem; }
  .faqs details { border-bottom: 1px solid var(--cream); padding: 0.75em 0; }
  .faqs summary { cursor: pointer; font-weight: 700; color: var(--ink); }
  .related .grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.25rem; } .related .grid > :global(.product-card) { flex: 1 1 180px; max-width: 220px; }
  @media (max-width: 780px) {
    .layout { grid-template-columns: 1fr; }
  }
</style>
