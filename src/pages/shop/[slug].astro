---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;
const onSale = typeof p.salePrice === 'number' && p.salePrice < p.price;
const cat = site.categories.find((c) => c.slug === p.category);

const allProducts = await getCollection('products');
const related = p.related
  .map((slug) => allProducts.find((r) => r.data.slug === slug))
  .filter(Boolean)
  .slice(0, 3);

// Spec keys are stored camelCase in frontmatter; the table needs human labels.
const SPEC_LABELS = {
  material: 'Material',
  size: 'Size',
  pages: 'Pages',
  seeds: 'Seeds',
  contents: 'Contents',
  packaging: 'Packaging',
  madeIn: 'Made in',
  madeBy: 'Made by',
};
// Unknown keys (a new one added through /admin) de-camelCase rather than print raw.
const specLabel = (k) =>
  SPEC_LABELS[k] || k.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase());
const specsEntries = Object.entries(p.specs || {});

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.sku || undefined,
  brand: { '@type': 'Brand', name: p.brand },
  description: p.seoDescription || p.answer || undefined,
  image: p.images.map((img) => new URL(img.src, site.hosts.canonical).toString()),
  offers: {
    '@type': 'Offer',
    price: onSale ? p.salePrice : p.price,
    priceCurrency: p.currency,
    availability: `https://schema.org/${p.availability}`,
    url: new URL(`/shop/${p.slug}/`, site.hosts.canonical).toString(),
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.hosts.canonical + '/' },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: new URL('/shop/', site.hosts.canonical).toString() },
    { '@type': 'ListItem', position: 3, name: cat ? cat.name : p.categoryName, item: new URL(`/shop/${p.category}/`, site.hosts.canonical).toString() },
    { '@type': 'ListItem', position: 4, name: p.name, item: new URL(`/shop/${p.slug}/`, site.hosts.canonical).toString() },
  ],
};
const faqSchema = p.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: p.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const inr = (n) =>
  '₹' + n.toLocaleString('en-IN', {
    minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
    maximumFractionDigits: 2,
  });

const whatsappMsg = encodeURIComponent(`Hi, I'd like to ask about bulk pricing for "${p.name}" (${p.sku || p.slug}).`);
---
<BaseLayout
  title={p.seoTitle || `${p.name} | Eco Happy`}
  description={p.seoDescription || p.answer || site.tagline}
  image={p.images?.[0]?.src}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <section class="container product">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/shop/">Shop</a>{cat && <> / <a href={cat.url}>{cat.name}</a></>} / {p.name}
    </nav>

    <div class="layout">
      <div class="gallery">
        {p.images.length > 0 ? (
          <>
            <img class="hero-img" id="hero-img" src={p.images[0].src} alt={p.images[0].alt || `${p.name}, Eco Happy`} width={p.images[0].width} height={p.images[0].height} />
            {p.images.length > 1 && (
              <div class="thumbs" role="group" aria-label={`${p.name} images`}>
                {p.images.map((img, i) => (
                  <button
                    type="button"
                    class="thumb"
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={`Show image ${i + 1} of ${p.images.length}`}
                    data-src={img.src}
                    data-alt={img.alt || `${p.name}, Eco Happy`}
                  >
                    <img src={img.src} alt="" loading="lazy" width="140" height="140" decoding="async" />
                  </button>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="hero-img placeholder" aria-hidden="true"></div>
        )}
      </div>

      <div class="info">
        {p.ribbon && <span class="badge">{p.ribbon}</span>}
        <h1>{p.name}</h1>
        {p.answer && <p class="answer">{p.answer}</p>}
        <p class="price">
          {onSale ? (
            <>
              <span class="was">Was {inr(p.price)}</span>
              <span class="now">Now {inr(p.salePrice)}</span>
            </>
          ) : (
            <span class="now">{inr(p.price)}</span>
          )}
        </p>

        <div class="cta-row">
          {p.bulk ? (
            <a class="btn btn-primary" href={`${site.whatsapp.direct}?text=${whatsappMsg}`} target="_blank" rel="noopener">
              Reach out on WhatsApp
            </a>
          ) : (
            <>
              <button class="btn btn-primary" type="button" id="buy-now" data-slug={p.slug} data-name={p.name}>
                Buy now
              </button>
              <a class="btn btn-outline" href={`${site.whatsapp.direct}?text=${whatsappMsg}`} target="_blank" rel="noopener">
                Ask about bulk / corporate pricing
              </a>
            </>
          )}
        </div>
        {p.bulk && <p class="made-to-order-note">Made to order, usually ready in about {p.leadTimeDays} days after we confirm your order on WhatsApp.</p>}
        {site.gstin && <p class="gst-note">GST invoice available on request</p>}

        <form id="buyer-details" class="buyer-details" hidden aria-label="Delivery and invoice details">
          <p class="buyer-details-intro">A few details for delivery and your invoice:</p>
          <div class="buyer-grid">
            <label>Full name<input type="text" name="buyerName" autocomplete="name" required /></label>
            <label>Email<input type="email" name="buyerEmail" autocomplete="email" required /></label>
            <label>Phone<input type="tel" name="buyerPhone" autocomplete="tel" required /></label>
            <label class="span-2">Delivery address<input type="text" name="buyerAddress" autocomplete="street-address" required /></label>
            <label>City<input type="text" name="buyerCity" autocomplete="address-level2" required /></label>
            <label>Pincode<input type="text" name="buyerPincode" autocomplete="postal-code" inputmode="numeric" required /></label>
          </div>
          <div class="buy-actions">
            <button class="btn btn-primary" type="submit" id="buy-continue">Continue to payment</button>
            <button class="buy-cancel" type="button" id="buy-cancel">Cancel</button>
          </div>
        </form>
        <p id="buy-status" class="buy-status" role="status" aria-live="polite"></p>

        {specsEntries.length > 0 && (
          <table class="specs">
            <caption class="visually-hidden">Product specifications</caption>
            <tbody>
              {specsEntries.map(([k, v]) => (
                <tr><th scope="row">{specLabel(k)}</th><td>{String(v)}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>

    <div class="description">
      <Content />
    </div>

    {p.faq.length > 0 && (
      <section class="faqs" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        {p.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>You may also like</h2>
        <div class="product-grid">
          {related.map((r) => <ProductCard product={r} />)}
        </div>
      </section>
    )}
  </section>
</BaseLayout>

<script>
  const btn = document.getElementById('buy-now');
  const status = document.getElementById('buy-status');
  const detailsForm = document.getElementById('buyer-details');

  // Gallery: thumbnails swap the main image.
  const heroImg = document.getElementById('hero-img');
  const thumbs = Array.from(document.querySelectorAll('.thumb'));
  if (heroImg instanceof HTMLImageElement) {
    thumbs.forEach((t) => {
      t.addEventListener('click', () => {
        heroImg.src = t.dataset.src || heroImg.src;
        heroImg.alt = t.dataset.alt || heroImg.alt;
        thumbs.forEach((o) => o.setAttribute('aria-pressed', String(o === t)));
      });
    });
  }

  function loadRazorpayScript() {
    return new Promise((resolve, reject) => {
      if (window.Razorpay) return resolve();
      const s = document.createElement('script');
      s.src = 'https://checkout.razorpay.com/v1/checkout.js';
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('Could not load the payment library. Check your connection and try again.'));
      document.body.appendChild(s);
    });
  }

  // Step 1: "Buy now" reveals the delivery/invoice details form instead of opening
  // Razorpay straight away -- we need a name, email, phone and address for the
  // shipping label and the branded invoice, none of which Razorpay's own modal collects.
  btn?.addEventListener('click', () => {
    btn.hidden = true;
    detailsForm.hidden = false;
    detailsForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
    detailsForm.querySelector('input[name="buyerName"]')?.focus();
  });

  // Leaving the details step must be possible: "Buy now" hides itself, so without
  // this the only way back to the product was a page reload.
  document.getElementById('buy-cancel')?.addEventListener('click', () => {
    detailsForm.hidden = true;
    btn.hidden = false;
    status.textContent = '';
    btn.focus();
  });

  // Netlify Forms AJAX submit: lands a durable order record in the Netlify Forms
  // dashboard (+ email notification) alongside the enquiry forms, without a new
  // database or account. See netlify/functions/verify-payment.js for why this
  // happens client-side rather than from the function.
  function submitOrderRecord(fields) {
    const body = new URLSearchParams({ 'form-name': 'orders', ...fields }).toString();
    return fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    }).catch(() => {
      // Best-effort: a failed order-record submission must never block the
      // customer's confirmation message, the payment already succeeded.
    });
  }

  function openInvoice(payload) {
    fetch('/.netlify/functions/generate-invoice', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then((res) => (res.ok ? res.text() : null))
      .then((html) => {
        if (!html) return;
        const win = window.open('', '_blank');
        if (win) {
          win.document.write(html);
          win.document.close();
        }
      })
      .catch(() => {
        // Best-effort: the invoice is a convenience document, not the payment record.
      });
  }

  detailsForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const slug = btn.dataset.slug;
    const name = btn.dataset.name;
    const fd = new FormData(detailsForm);
    const buyer = {
      name: String(fd.get('buyerName') || ''),
      email: String(fd.get('buyerEmail') || ''),
      phone: String(fd.get('buyerPhone') || ''),
      address: String(fd.get('buyerAddress') || ''),
      city: String(fd.get('buyerCity') || ''),
      pincode: String(fd.get('buyerPincode') || ''),
    };
    const continueBtn = document.getElementById('buy-continue');
    continueBtn.disabled = true;
    status.textContent = 'Preparing checkout…';
    try {
      const [orderRes] = await Promise.all([
        fetch('/.netlify/functions/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, quantity: 1, buyer }),
        }),
        loadRazorpayScript(),
      ]);
      if (!orderRes.ok) {
        const err = await orderRes.json().catch(() => ({}));
        throw new Error(err.error || 'Could not start checkout.');
      }
      const order = await orderRes.json();

      const rzp = new window.Razorpay({
        key: order.keyId,
        order_id: order.orderId,
        amount: order.amount,
        currency: order.currency,
        name: 'Eco Happy',
        description: order.productName,
        image: '/assets/brand/logo-eco-happy.png',
        theme: { color: '#2F4739' },
        prefill: { name: buyer.name, email: buyer.email, contact: buyer.phone },
        handler: async (response) => {
          status.textContent = 'Verifying payment…';
          try {
            const verifyRes = await fetch('/.netlify/functions/verify-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(response),
            });
            const result = await verifyRes.json();
            if (result.verified) {
              status.textContent = `Payment confirmed, thank you! We'll be in touch about delivery for your ${name}. Your invoice is opening in a new tab, you can save it as a PDF from there.`;
              await submitOrderRecord({
                name: buyer.name,
                email: buyer.email,
                phone: buyer.phone,
                address: buyer.address,
                city: buyer.city,
                pincode: buyer.pincode,
                product: name,
                quantity: '1',
                amount: String((order.amount || 0) / 100),
                payment_id: response.razorpay_payment_id,
                order_id: response.razorpay_order_id,
              });
              openInvoice({
                slug,
                quantity: 1,
                buyer,
                paymentId: response.razorpay_payment_id,
                orderId: response.razorpay_order_id,
              });
            } else {
              status.textContent = 'We could not verify that payment. Please contact us on WhatsApp with your payment ID before retrying.';
            }
          } catch {
            status.textContent = 'Payment may have gone through, but we could not confirm it here, please contact us on WhatsApp with your payment ID.';
          } finally {
            continueBtn.disabled = false;
          }
        },
        modal: {
          ondismiss: () => {
            status.textContent = '';
            continueBtn.disabled = false;
          },
        },
      });
      rzp.on('payment.failed', () => {
        status.textContent = 'Payment failed, no charge was made. You can try again.';
        continueBtn.disabled = false;
      });
      rzp.open();
      status.textContent = '';
    } catch (err) {
      status.textContent = err.message || 'Something went wrong starting checkout.';
      continueBtn.disabled = false;
    }
  });
</script>


<style>
  .product { padding-block: 1.5rem 3rem; }
  .crumb { font-size: 0.85rem; }
  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; margin-block: 1rem 2rem; }
  .hero-img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--radius); background: var(--cream); }
  .hero-img.placeholder { display: block; }
  /* Thumbnails were plain <img> with no handler: they read as interactive and
     were not. Now real buttons that swap the main image, 72px tap target. */
  .thumbs { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.75rem; }
  .thumb {
    padding: 0; line-height: 0; cursor: pointer; overflow: hidden;
    background: var(--white); border: 1px solid var(--gray-200); border-radius: 6px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .thumb img { width: 70px; height: 70px; object-fit: cover; display: block; }
  .thumb:hover { border-color: var(--forest); }
  .thumb[aria-pressed='true'] { border-color: var(--forest); box-shadow: inset 0 0 0 1px var(--forest); }
  /* --red-deep now means price/sale only. The summary line was competing with
     the price for the same signal; ProductCard already used --gray-500 here. */
  .answer { font-size: 1.05rem; color: var(--gray-500); }
  .price { font-size: 1.4rem; font-weight: 600; margin: 1rem 0; }
  .was { text-decoration: line-through; color: var(--gray-500); font-weight: 400; margin-right: 0.6em; font-size: 0.85em; }
  .now { color: var(--red-deep); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; }
  .buy-status { min-height: 1.2em; font-size: 0.9rem; color: var(--red-deep); font-weight: 600; }
  .buy-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .buy-cancel {
    font: inherit; font-size: 0.85rem; color: var(--gray-500); background: none;
    border: 0; padding: 0.5em 0.25em; min-height: 44px; cursor: pointer; text-decoration: underline;
  }
  .buy-cancel:hover { color: var(--ink); }
  .buyer-details {
    margin-top: 1rem; padding: 1.1rem 1.25rem; background: var(--cream);
    border-radius: var(--radius); max-width: 460px;
  }
  .buyer-details-intro { margin: 0 0 0.85rem; font-size: 0.85rem; font-weight: 600; color: var(--ink); }
  .buyer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem 1rem; margin-bottom: 1rem; }
  .buyer-grid label {
    display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.82rem; font-weight: 600; color: var(--ink);
  }
  .buyer-grid .span-2 { grid-column: 1 / -1; }
  .buyer-grid input {
    font: inherit; font-weight: 400; padding: 0.55em 0.7em; border: 1px solid var(--gray-300, var(--gray-200));
    border-radius: 6px; background: var(--white); color: var(--ink);
  }
  .buyer-grid input:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  @media (max-width: 480px) {
    .buyer-grid { grid-template-columns: 1fr; }
  }
  .made-to-order-note { font-size: 0.85rem; color: var(--gray-500); margin: -0.75rem 0 1rem; }
  .gst-note { font-size: 0.85rem; color: var(--gray-500); margin: -0.75rem 0 1rem; }
  .specs { border-collapse: collapse; width: 100%; margin-top: 1rem; }
  /* Was `.specs th.specs td` -- a descendant chain that matched nothing, so the
     spec table shipped completely unstyled: centred bold headers, no padding,
     no row rules. The missing character was a comma. */
  .specs th, .specs td { text-align: left; padding: 0.4em 0.6em 0.4em 0; border-bottom: 1px solid var(--cream); font-size: 0.9rem; }
  .specs th { color: var(--ink); font-weight: 700; width: 40%; }
  .description { max-width: 68ch; margin-bottom: 2.5rem; }
  .faqs { max-width: 68ch; margin-bottom: 2.5rem; }
  .faqs details { border-bottom: 1px solid var(--cream); padding: 0.75em 0; }
  .faqs summary { cursor: pointer; font-weight: 700; color: var(--ink); }
  .related { margin-bottom: 1rem; }
  @media (max-width: 780px) {
    .layout { grid-template-columns: 1fr; }
  }
</style>
