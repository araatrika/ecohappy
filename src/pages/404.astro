---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title="Page not found | Eco Happy" description="That page isn't here. Browse the shop, corporate gifting or message us on WhatsApp." noindex>
  <section class="container not-found">
    <p class="kicker">Error 404</p>
    <h1>We couldn't find that page</h1>
    <p class="lede">The link may be old or mistyped. These are good places to start.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/shop/">Shop plantable stationery</a>
      <a class="btn btn-outline" href="/gifting/corporate/">Corporate gifting</a>
      <a class="btn btn-outline" href={site.whatsapp.direct} rel="noopener" target="_blank">Message us on WhatsApp</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { max-width: 60ch; padding-block: 3.5rem 4.5rem; }
  .kicker { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gray-500); margin-bottom: 0.5rem; }
  .lede { color: var(--gray-500); margin: 0.25rem 0 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
