---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import site from '../data/site.json';

const homePage = await getEntry('pages', 'home');
const allProducts = (await getCollection('products')).filter((p) => !p.data.retired);
const featuredNames = homePage?.data.productsListed || [];
const featured = featuredNames
  .map((name) => allProducts.find((p) => p.data.name.toLowerCase() === name.toLowerCase()))
  .filter(Boolean);

const categoryTiles = site.categories.map((cat) => {
  const inCategory = allProducts.filter((p) => p.data.category === cat.slug);
  const cover = inCategory.find((p) => p.data.images?.length)?.data.images?.[0];
  return { ...cat, count: inCategory.length, cover };
});

const values = [
  {
    title: 'No plastic',
    body: 'Every product and its packaging are plastic-free, start to finish.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6v3l1.5 2v13a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2V7L9 5V2Z"/><path d="M9 5h6"/><line x1="4" y1="4" x2="20" y2="20" stroke="var(--red-deep)"/></svg>',
  },
  {
    title: 'Hand-made in Pune',
    body: 'Rolled and assembled by our women-led team in Parvati Paytha.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11.5V5.5a1.5 1.5 0 0 1 3 0v5"/><path d="M10 10.5V4.5a1.5 1.5 0 0 1 3 0v6"/><path d="M13 10.5V6a1.5 1.5 0 0 1 3 0v6.5"/><path d="M16 12V9a1.5 1.5 0 0 1 3 0v6.5c0 3.31-2.69 6-6 6h-1.5c-1.86 0-2.86-.73-3.8-1.9l-3-3.7a1.6 1.6 0 0 1 .5-2.4c.77-.4 1.7-.2 2.28.5L9 15.8"/></svg>',
  },
  {
    title: 'Plant it after use',
    body: 'Seed pencils, paper and rakhis are made to be planted, not thrown away.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V11"/><path d="M12 11c0-4-3-6.5-7-6.5C5 8.5 8 11 12 11Z"/><path d="M12 7.5c0-2.8 2.7-5 6-5 0 2.8-2.7 5-6 5Z"/></svg>',
  },
  {
    title: 'Real, not stock',
    body: 'Every photo on this site is our own product — nothing AI-generated.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.2"/></svg>',
  },
];
---
<BaseLayout
  title="Eco Friendly Products In India | Eco Happy"
  description="Plantable seed pencils, upcycled diaries and sustainable gifts — hand-made in Pune by a women-led team since 2017, from waste newspaper and upcycled fabric."
>
  <p class="announce">
    <a href="/gifting/corporate/">Planning Diwali gifting? Bulk seed pencils with your logo — ask us on WhatsApp →</a>
  </p>

  <section class="hero section-cream">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Made in Pune since 2017</span>
        <h1>Stationery that grows into a plant, not landfill</h1>
        <p class="lede">
          Hand-rolled from waste newspaper by a women-led team in Pune.
          Write with it, plant it, watch it grow — no plastic, ever.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/shop/">Shop now</a>
          <a class="btn btn-outline" href="/gifting/corporate/">Corporate gifting</a>
        </div>
      </div>
      <img class="hero-img" src="/assets/brand/home-hero-product-range.jpg" alt="A flat-lay of Eco Happy's seed pencils, upcycled diaries and plantable kits on a cream cloth" width="640" height="480" />
    </div>
  </section>

  <section class="container values">
    <div class="grid four">
      {values.map((v) => (
        <div class="value">
          <span class="value-icon" aria-hidden="true" set:html={v.icon} />
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container shop-by-cat">
    <h2>Shop by category</h2>
    <div class="cat-grid">
      {categoryTiles.map((cat) => (
        <a class="cat-card card" href={cat.url}>
          <div class="cat-media">
            {cat.cover ? (
              <img src={cat.cover.src} alt={cat.cover.alt || cat.name} loading="lazy" width="300" height="220" />
            ) : (
              <div class="cat-media placeholder" aria-hidden="true"></div>
            )}
          </div>
          <div class="cat-body">
            <h3>{cat.name}</h3>
            <span class="cat-count">{cat.count} product{cat.count === 1 ? '' : 's'} &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container featured">
    <h2>Shop our favourites</h2>
    {featured.length > 0 ? (
      <div class="grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    ) : (
      <p><a href="/shop/all-products/">See everything we make →</a></p>
    )}
    <p class="see-all"><a class="btn btn-outline" href="/shop/all-products/">See all products</a></p>
  </section>

  <section class="container impact-teaser">
    <div class="impact-inner">
      <div class="impact-copy">
        <span class="eyebrow">New</span>
        <h2>How much does switching actually save?</h2>
        <p>Three quick calculators for pens, pencils, notebooks and corporate bulk orders &mdash; built on published emission factors, not invented numbers.</p>
        <a class="btn btn-primary" href="/impact-calculator/">Try the impact calculator</a>
      </div>
      <div class="impact-stats" aria-hidden="true">
        <div class="mini-stat"><span>~2.5</span>kg CO2e per kg of plastic avoided</div>
        <div class="mini-stat"><span>~10g</span>plastic in a typical pen, per unit</div>
        <div class="mini-stat"><span>45%</span>less CO2e from recycled vs virgin paper</div>
      </div>
    </div>
  </section>

  <section class="section-dark trust">
    <div class="container trust-inner">
      <span class="eyebrow eyebrow-dark">Honesty, not greenwashing</span>
      <h2>Made by hand, in the open</h2>
      <p>
        Every pencil is rolled by hand from old newspaper by our team of eight women in Parvati Paytha, Pune.
        We're building an honest, dated record of what we actually make and use — no invented numbers, ever.
        Read <a href="/about/">how Eco Happy works</a> and <a href="/learn/">what actually happens when you plant a seed pencil</a>.
      </p>
    </div>
  </section>

  <section class="container gifting-strip">
    <h2>Gifting, done right</h2>
    <div class="grid three">
      <a class="card gift-card" href="/gifting/corporate/">
        <h3>Corporate gifting</h3>
        <p>MOQ, branding and lead times for Diwali, onboarding and client gifts.</p>
        <span class="card-link">Explore →</span>
      </a>
      <a class="card gift-card" href="/gifting/return-gifts/">
        <h3>Return gifts</h3>
        <p>Birthday and celebration gifts kids and parents actually keep.</p>
        <span class="card-link">Explore →</span>
      </a>
      <a class="card gift-card" href="/gifting/bulk-and-custom/">
        <h3>Bulk & custom</h3>
        <p>Logo printing and custom text on seed pencils, diaries and more.</p>
        <span class="card-link">Explore →</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .announce {
    margin: 0; text-align: center; background: var(--red); color: var(--ink);
    font-weight: 700; font-size: 0.85rem; padding: 0.6em 1em; letter-spacing: 0.02em;
  }
  .announce a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  .hero { padding-block: 3.5rem; }
  .hero-inner { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; }
  .eyebrow {
    display: inline-block; font-family: var(--font-body); font-weight: 700; font-size: 0.78rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--red-deep); margin-bottom: 0.75rem;
  }
  .eyebrow-dark { color: var(--gold); }
  .lede { font-size: 1.15rem; max-width: 46ch; }
  .hero-img { width: 100%; height: auto; border-radius: var(--radius); object-fit: cover; box-shadow: var(--shadow-card); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }

  .values { padding-block: 2.75rem 0.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.25rem; margin-top: 1rem; }
  .featured .grid { display: flex; flex-wrap: wrap; justify-content: center; }
  .featured .grid > :global(.product-card) { flex: 1 1 180px; max-width: 220px; }
  .grid.four { grid-template-columns: repeat(4, 1fr); gap: 1.75rem; }
  .value {
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem;
    padding: 1.1rem 1rem 1.25rem; border-radius: var(--radius); border: 1px solid transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .value:hover, .value:focus-within {
    transform: translateY(-3px); border-color: var(--gray-200); background: var(--white);
    box-shadow: 0 8px 20px rgba(13,13,13,0.08);
  }
  .value-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%; background: var(--cream); color: var(--ink);
    flex-shrink: 0; transition: background 0.15s ease, transform 0.15s ease;
  }
  .value-icon :global(svg) { width: 22px; height: 22px; }
  .value:hover .value-icon { background: var(--gold); transform: scale(1.08) rotate(-4deg); }
  .value h3 { font-size: 1rem; text-transform: none; margin: 0; }
  .value p { font-size: 0.88rem; color: var(--gray-500); margin: 0; }

  .shop-by-cat { padding-block: 1rem 0.5rem; }
  .cat-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.25rem; margin-top: 1.25rem; }
  .cat-card {
    display: block; text-decoration: none; color: var(--ink); overflow: hidden; border: 1px solid var(--gray-200);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(13,13,13,0.1); }
  .cat-media { aspect-ratio: 4 / 3; background: var(--gray-100); overflow: hidden; }
  .cat-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .cat-card:hover .cat-media img { transform: scale(1.08); }
  .cat-body { padding: 0.85rem 0.9rem 1rem; }
  .cat-body h3 { font-size: 0.95rem; text-transform: none; margin-bottom: 0.35em; }
  .cat-count { font-weight: 700; color: var(--red-deep); font-size: 0.78rem; }

  .featured { padding-block: 3rem; }
  .see-all { text-align: center; margin-top: 2rem; }
  .grid.three { grid-template-columns: repeat(3, 1fr); }

  .impact-teaser { padding-block: 1rem 3rem; }
  .impact-inner {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center;
    background: var(--blush); border-radius: var(--radius); padding: 2rem;
  }
  .impact-copy .eyebrow { display: inline-block; background: var(--ink); color: var(--white); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.25em 0.6em; border-radius: 4px; margin-bottom: 0.75em; }
  .impact-copy h2 { margin-bottom: 0.4em; }
  .impact-copy p { color: var(--gray-500); margin-bottom: 1.25em; max-width: 42ch; }
  .impact-stats { display: flex; flex-direction: column; gap: 0.9rem; }
  .mini-stat { background: var(--white); border-radius: var(--radius); padding: 0.85rem 1rem; font-size: 0.82rem; color: var(--gray-500); }
  .mini-stat span { display: block; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; color: var(--ink); }

  .trust { padding-block: 3rem; }
  .trust-inner { max-width: 68ch; }

  .gifting-strip { padding-block: 1rem 3.5rem; }
  .gift-card {
    display: block; padding: 1.5rem; text-decoration: none; color: var(--ink);
    border-top: 4px solid var(--gold); transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .gift-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(13,13,13,0.12); }
  .gift-card h3 { margin-bottom: 0.4em; }
  .gift-card p { margin: 0 0 0.75em; font-size: 0.9rem; }
  .card-link { font-weight: 700; color: var(--red-deep); font-size: 0.85rem; }

  @media (max-width: 900px) {
    .grid.four { grid-template-columns: repeat(2, 1fr); }
    .cat-grid { grid-template-columns: repeat(3, 1fr); }
    .impact-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 780px) {
    .hero-inner { grid-template-columns: 1fr; }
    .grid.three { grid-template-columns: 1fr; }
    .grid.four { grid-template-columns: 1fr 1fr; }
    .cat-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
