---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div>
      <img
        class="footer-logo"
        src="/assets/brand/logo-eco-happy.png"
        alt={`${site.brand} logo`}
        width="44"
        height="48"
        loading="lazy"
      />
      <h2>{site.brand}<span class="tm">&reg;</span></h2>
      <p>{site.tagline}</p>
      <p>
        {site.address.streetAddress},<br />
        {site.address.addressLocality}, {site.address.addressRegion} {site.address.postalCode}, India
      </p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {site.gstin && <p class="gstin">GSTIN: {site.gstin} &middot; GST invoice available on request</p>}
    </div>
    <div>
      <h3>Shop</h3>
      <ul>
        <li><a href="/shop/all-products/">All products</a></li>
        <li><a href="/customisation/">Customisation</a></li>
        <li><a href="/gifting/corporate/">Corporate gifting</a></li>
        <li><a href="/gifting/seasonal/">Seasonal & informal gifting</a></li>
      </ul>
    </div>
    <div>
      <h3>Company</h3>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/blogs/">Blogs</a></li>
        <li><a href="/events/">Events</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/shipping-and-returns/">Shipping & returns</a></li>
        <li><a href="/terms/">Terms & conditions</a></li>
      </ul>
    </div>
    <div>
      <h3>Follow &amp; chat</h3>
      <ul class="social">
        {site.sameAs.filter((u) => u.includes('instagram')).map((u) => (
          <li>
            <a class="social-link" href={u} rel="me noopener" target="_blank">
              <span class="ico" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8.74 0 8.333.014 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.014 8.333 0 8.74 0 12s.014 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.986 8.74 24 12 24s3.667-.014 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.058-1.28.072-1.687.072-4.947s-.014-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.014 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227a3.81 3.81 0 0 1-.9 1.382 3.744 3.744 0 0 1-1.38.896c-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421a3.716 3.716 0 0 1-1.379-.9 3.644 3.644 0 0 1-.9-1.38c-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.846-10.405a1.441 1.441 0 1 1-2.883.001 1.441 1.441 0 0 1 2.883-.001z"/></svg>`} />
              Instagram
            </a>
          </li>
        ))}
        {site.sameAs.filter((u) => u.includes('facebook')).map((u) => (
          <li>
            <a class="social-link" href={u} rel="me noopener" target="_blank">
              <span class="ico" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.732-.007c-.383 0-.744.023-1.058.055a2.006 2.006 0 0 0-.797.202 1.008 1.008 0 0 0-.487.474 2.008 2.008 0 0 0-.166.914v1.336h3.481l-.427 3.667h-3.056v7.98H9.101z"/></svg>`} />
              Facebook
            </a>
          </li>
        ))}
        {site.sameAs.filter((u) => u.includes('linkedin')).map((u) => (
          <li>
            <a class="social-link" href={u} rel="me noopener" target="_blank">
              <span class="ico" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`} />
              LinkedIn
            </a>
          </li>
        ))}
        <li>
          <a class="social-link" href={site.whatsapp.direct} rel="noopener" target="_blank">
            <span class="ico" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>`} />
            WhatsApp us
          </a>
        </li>
      </ul>
      <p class="enquiries">Enquiries: <a href={site.whatsapp.direct} rel="noopener" target="_blank">message us on WhatsApp</a></p>
    </div>
  </div>
  <div class="container fine">
    <p>&copy; {year} {site.legalName}, trading as {site.brand}&reg;. Made in Pune, India.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--white); margin-top: 3rem; padding-block: 2.5rem 1rem; }
  .site-footer a { color: var(--gold); }
  .footer-logo { display: block; margin-bottom: 0.6rem; }
  .site-footer h2, .site-footer h3 { color: var(--white); font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .tm { font-size: 0.6em; vertical-align: super; margin-left: 0.1em; }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2rem; }
  .grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4em; }
  .social-link { display: inline-flex; align-items: center; gap: 0.5em; transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.15s ease; }
  .social-link:hover { transform: translateX(3px); color: var(--white); }
  .social-link .ico {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.6em; height: 1.6em; border-radius: 50%; background: rgba(255, 214, 0, 0.15);
    color: var(--gold); padding: 0.32em; box-sizing: border-box;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .social-link .ico :global(svg) { width: 100%; height: 100%; display: block; }
  .social-link:hover .ico { background: var(--gold); color: var(--ink); transform: scale(1.08) rotate(-4deg); }
  .enquiries { margin-top: 0.9em; font-size: 0.85rem; opacity: 0.85; }
  .gstin { font-size: 0.8rem; opacity: 0.75; margin-top: 0.75em; }
  .fine { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.15); font-size: 0.85rem; opacity: 0.85; }
  @media (max-width: 780px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
</style>
